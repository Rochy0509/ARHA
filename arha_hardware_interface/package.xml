<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arha_hardware_interface</name>
  <version>0.0.0</version>
  <description>ROS2 hardware interface for ARHA project using TCP/IP communication to a stm32h723zg</description>
  <maintainer email="kennethaldahir.martinezmoreno@ontariotechu.net">Kenneth Martinez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <build_depend>arha_tcp_driver</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
