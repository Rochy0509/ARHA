<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arha_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="zero_on_startup" default="false" />

    <!-- URDF Include -->
    <xacro:include filename="$(find arha_description)/urdf/ARHA.urdf" />

    <!-- Gripper and Camera Assembly -->
    <xacro:include filename="$(find arha_moveit2)/config/grippers/pincopen_stub.xacro"/>
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />

    <xacro:pincopen_gripper prefix="left" parent="WristLD_link">
      <origin xyz="0 0 0.13" rpy="1.5708 -1.5708 3.14159" />
    </xacro:pincopen_gripper>

    <xacro:sensor_d435 parent="left_Camera_mount_V1" name="left_camera" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
      <origin xyz="-0.01 -0.008 0.011" rpy="0 0 1.5708"/>
    </xacro:sensor_d435>
    
    <xacro:pincopen_gripper prefix="right" parent="WristRD_link">
      <origin xyz="0 0 0.13" rpy="1.5708 -1.5708 0.0" />
    </xacro:pincopen_gripper>

    <xacro:sensor_d435 parent="right_Camera_mount_V1" name="right_camera" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
      <origin xyz="-0.01 -0.008 0.011" rpy="0 0 1.5708"/>
    </xacro:sensor_d435>

    <!-- Control Include -->
    <xacro:include filename="arha_description.ros2_control.xacro" />


    <xacro:arha_description_ros2_control name="ARHA" initial_positions_file="$(arg initial_positions_file)" use_fake_hardware="$(arg use_fake_hardware)" zero_on_startup="$(arg zero_on_startup)"/>

</robot>
