<?xml version="1.0" encoding="UTF-8"?>
<!--Right arm only SRDF — left arm disabled due to CAN bus damage -->
<robot name="arha_description">
    <group name="right_arm">
        <joint name="ShoulderRU_joint"/>
        <joint name="ShoulderRD_joint"/>
        <joint name="ElbowRU_joint"/>
        <joint name="ElbowRD_joint"/>
        <joint name="WristRU_joint"/>
        <joint name="WristRD_joint"/>
    </group>
    <group name="right_gripper">
        <joint name="right_gripper_mount_joint"/>
        <joint name="right_cam_joint"/>
    </group>
    <end_effector name="right_gripper_ee" parent_link="WristRD_link" group="right_gripper" parent_group="right_arm"/>
    <!--GROUP STATES-->
    <group_state name="right_arm_home" group="right_arm">
        <joint name="ElbowRD_joint" value="0"/>
        <joint name="ElbowRU_joint" value="0"/>
        <joint name="ShoulderRD_joint" value="0"/>
        <joint name="ShoulderRU_joint" value="0"/>
        <joint name="WristRD_joint" value="0"/>
        <joint name="WristRU_joint" value="0"/>
    </group_state>
    <group_state name="right_ready" group="right_arm">
        <joint name="ElbowRD_joint" value="1.5708"/>
        <joint name="ElbowRU_joint" value="0"/>
        <joint name="ShoulderRD_joint" value="0"/>
        <joint name="ShoulderRU_joint" value="0"/>
        <joint name="WristRD_joint" value="0"/>
        <joint name="WristRU_joint" value="0"/>
    </group_state>
    <group_state name="right_pre_grasp" group="right_arm">
        <joint name="ShoulderRU_joint" value="0.5"/>
        <joint name="ShoulderRD_joint" value="0.0"/>
        <joint name="ElbowRU_joint"    value="0.0"/>
        <joint name="ElbowRD_joint"    value="1.2"/>
        <joint name="WristRU_joint"    value="0.0"/>
        <joint name="WristRD_joint"    value="0.0"/>
    </group_state>
    <!--VIRTUAL JOINT-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="world_link"/>
    <!--DISABLE COLLISIONS: right arm and body -->
    <disable_collisions link1="WristRD_link" link2="right_Bottom_Plate" reason="Adjacent"/>
    <disable_collisions link1="WristRD_link" link2="right_Cam" reason="Never"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_Cam" reason="Adjacent"/>
    <disable_collisions link1="ElbowRD_link" link2="ElbowRU_link" reason="Adjacent"/>
    <disable_collisions link1="ElbowRD_link" link2="WristRU_link" reason="Adjacent"/>
    <disable_collisions link1="ElbowRD_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ElbowRU_link" link2="ShoulderRD_link" reason="Adjacent"/>
    <disable_collisions link1="ElbowRU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ElbowRU_link" link2="chest_link" reason="Never"/>
    <disable_collisions link1="ShoulderRD_link" link2="ShoulderRU_link" reason="Adjacent"/>
    <disable_collisions link1="ShoulderRD_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ShoulderRD_link" link2="chest_link" reason="Never"/>
    <disable_collisions link1="ShoulderRU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ShoulderRU_link" link2="chest_link" reason="Adjacent"/>
    <disable_collisions link1="WristRD_link" link2="WristRU_link" reason="Adjacent"/>
    <disable_collisions link1="WristRD_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="WristRU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="chest_link" reason="Adjacent"/>
    <!-- Right gripper internal collisions -->
    <disable_collisions link1="right_Removable_Tip" link2="right_Removable_Tip_1" reason="Never"/>
    <disable_collisions link1="right_Distal_Rod" link2="right_Distal_Rod_1" reason="Never"/>
    <disable_collisions link1="right_Distal_Shell" link2="right_Distal_Shell_1" reason="Never"/>
    <disable_collisions link1="right_Internal_Rod" link2="right_Internal_Rod_1" reason="Never"/>
    <disable_collisions link1="right_External_Rod" link2="right_External_Rod_1" reason="Never"/>
    <disable_collisions link1="right_Tip_Support" link2="right_Tip_Support_1" reason="Never"/>
    <disable_collisions link1="right_Removable_Tip" link2="right_Distal_Shell" reason="Adjacent"/>
    <disable_collisions link1="right_Removable_Tip_1" link2="right_Distal_Shell_1" reason="Adjacent"/>
    <disable_collisions link1="right_Removable_Tip" link2="right_Tip_Support" reason="Adjacent"/>
    <disable_collisions link1="right_Removable_Tip_1" link2="right_Tip_Support_1" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_Top_Plate" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_Cam" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_Internal_Rod" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_Internal_Rod_1" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_External_Rod" reason="Adjacent"/>
    <disable_collisions link1="right_Bottom_Plate" link2="right_External_Rod_1" reason="Adjacent"/>
    <disable_collisions link1="right_Top_Plate" link2="right_Camera_basement" reason="Adjacent"/>
    <disable_collisions link1="right_Top_Plate" link2="right_Interface_ARM100" reason="Adjacent"/>
    <disable_collisions link1="right_Camera_basement" link2="right_Camera_mount_V1" reason="Adjacent"/>
    <disable_collisions link1="right_Interface_ARM100" link2="right_Hand_adaptor_plate" reason="Adjacent"/>
    <disable_collisions link1="right_Internal_Rod_1" link2="right_Distal_Rod" reason="Adjacent"/>
    <disable_collisions link1="right_Internal_Rod" link2="right_Distal_Rod_1" reason="Adjacent"/>
    <disable_collisions link1="right_Distal_Rod" link2="right_Removable_Tip_1" reason="Adjacent"/>
    <disable_collisions link1="right_Distal_Rod_1" link2="right_Removable_Tip" reason="Adjacent"/>
    <!-- Left Arm Disclosures for static pose -->
    <disable_collisions link1="ShoulderLU_link" link2="chest_link" reason="Adjacent"/>
    <disable_collisions link1="ShoulderLD_link" link2="ShoulderLU_link" reason="Adjacent"/>
    <disable_collisions link1="ElbowLU_link" link2="ShoulderLD_link" reason="Adjacent"/>
    <disable_collisions link1="ElbowLD_link" link2="ElbowLU_link" reason="Adjacent"/>
    <disable_collisions link1="WristLU_link" link2="ElbowLD_link" reason="Adjacent"/>
    <disable_collisions link1="WristLD_link" link2="WristLU_link" reason="Adjacent"/>
    <disable_collisions link1="ShoulderLU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ShoulderLD_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ElbowLU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="ElbowLD_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="WristLU_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="WristLD_link" link2="base_link" reason="Never"/>

    <!-- Head Assembly Collisions -->
    <disable_collisions link1="chest_link" link2="head_part_1_1" reason="Adjacent"/>
    <disable_collisions link1="chest_link" link2="head_part_1_2" reason="Never"/>
    <disable_collisions link1="chest_link" link2="head_part_1_3" reason="Never"/>
    <disable_collisions link1="chest_link" link2="head_part_1_4" reason="Never"/>
    <disable_collisions link1="chest_link" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="chest_link" link2="head_part_1" reason="Never"/>

    <disable_collisions link1="head_part_1_1" link2="head_part_1_2" reason="Adjacent"/>
    <disable_collisions link1="head_part_1_1" link2="head_part_1_3" reason="Never"/>
    <disable_collisions link1="head_part_1_1" link2="head_part_1_4" reason="Never"/>
    <disable_collisions link1="head_part_1_1" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="head_part_1_1" link2="head_part_1" reason="Never"/>

    <disable_collisions link1="head_part_1_2" link2="head_part_1_3" reason="Never"/>
    <disable_collisions link1="head_part_1_2" link2="head_part_1_4" reason="Adjacent"/>
    <disable_collisions link1="head_part_1_2" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="head_part_1_2" link2="head_part_1" reason="Never"/>

    <disable_collisions link1="head_part_1_3" link2="head_part_1_4" reason="Adjacent"/>
    <disable_collisions link1="head_part_1_3" link2="head_part_1_5" reason="Adjacent"/>
    <disable_collisions link1="head_part_1_3" link2="head_part_1" reason="Adjacent"/>

    <disable_collisions link1="head_part_1_4" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="head_part_1_4" link2="head_part_1" reason="Never"/>

    <disable_collisions link1="head_part_1_5" link2="head_part_1" reason="Never"/>

    <disable_collisions link1="ShoulderLU_link" link2="head_part_1_1" reason="Never"/>
    <disable_collisions link1="ShoulderLU_link" link2="head_part_1_2" reason="Never"/>
    <disable_collisions link1="ShoulderRU_link" link2="head_part_1_1" reason="Never"/>
    <disable_collisions link1="ShoulderRU_link" link2="head_part_1_2" reason="Never"/>

    <!-- Head Camera Collisions -->
    <disable_collisions link1="head_camera_link" link2="head_part_1_1" reason="Never"/>
    <disable_collisions link1="head_camera_link" link2="head_part_1_2" reason="Never"/>
    <disable_collisions link1="head_camera_link" link2="head_part_1_3" reason="Never"/>
    <disable_collisions link1="head_camera_link" link2="head_part_1_4" reason="Adjacent"/>
    <disable_collisions link1="head_camera_link" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="head_camera_link" link2="head_part_1" reason="Never"/>
    <disable_collisions link1="head_camera_link" link2="chest_link" reason="Never"/>

    <!-- Head vs Base Link Collisions -->
    <disable_collisions link1="base_link" link2="head_part_1_1" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_part_1_2" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_part_1_3" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_part_1_4" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_part_1_5" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_part_1" reason="Never"/>
    <disable_collisions link1="base_link" link2="head_camera_link" reason="Never"/>
</robot>
