<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Include the Robotiq Hand-E gripper -->
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande_gripper.xacro"/>
  
  <!-- Instantiate right gripper (ros2_control disabled for Gazebo Classic) -->
  <xacro:robotiq_hande_gripper
    name="right_gripper"
    prefix="right_"
    parent="WristRD_link"
    grip_pos_min="0.0"
    grip_pos_max="0.025"
    tty_port="/dev/null"
    baudrate="115200"
    parity="N"
    data_bits="8"
    stop_bit="1"
    slave_id="10"
    use_fake_hardware="true"
    xyz="0 0 0.06"
    rpy="0 0 0"
    use_mimic="false"
    use_ros2_control="false"
  />
  
  <!-- NOTE: ros2_control for gripper joints is defined in arha_with_grippers.urdf.xacro
       to avoid duplicate ros2_control blocks in Gazebo Classic -->

  <!-- Add gazebo_grasp_fix plugin for grasping objects (commented out for now) -->
  <!--
