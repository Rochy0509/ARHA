    <plugin name="right_gripper_grasp" filename="libgazebo_grasp_fix.so">
      <arm>
        <arm_name>right_gripper</arm_name>
        <palm_link>right_robotiq_hande_link</palm_link>
        <gripper_link>right_robotiq_hande_left_finger</gripper_link>
        <gripper_link>right_robotiq_hande_right_finger</gripper_link>
      </arm>
      <forces_angle_tolerance>100</forces_angle_tolerance>
      <update_rate>4</update_rate>
      <grip_count_threshold>4</grip_count_threshold>
      <max_grip_count>8</max_grip_count>
      <release_tolerance>0.005</release_tolerance>
      <disable_collisions_on_attach>false</disable_collisions_on_attach>
    </plugin>
  </gazebo>
  -->
  
</robot>
