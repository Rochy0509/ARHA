<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include RealSense D435 description -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <!-- Instantiate RealSense D435 directly on gripper link -->
  <xacro:sensor_d435 parent="right_robotiq_hande_link" name="camera_right_wrist" use_nominal_extrinsics="true">
    <!-- Position - slightly to the side and forward of gripper -->
    <origin xyz="0.0 -0.075 0.0005" rpy="0 -1.5708 -1.5708"/>
  </xacro:sensor_d435>

  <!-- Gazebo material for camera appearance -->
  <gazebo reference="camera_right_wrist_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="camera_right_wrist_bottom_screw_frame">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Gazebo Classic Depth Camera Plugin (includes RGB and Depth) -->
  <gazebo reference="camera_right_wrist_depth_frame">
    <sensor type="depth" name="camera_right_wrist">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_right_wrist_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera_right_wrist</namespace>
          <remapping>~/image_raw:=color/image</remapping>
          <remapping>~/camera_info:=color/camera_info</remapping>
          <remapping>~/depth/image_raw:=depth/image</remapping>
          <remapping>~/depth/camera_info:=depth/camera_info</remapping>
          <remapping>~/points:=depth/points</remapping>
        </ros>
        <frame_name>camera_right_wrist_depth_optical_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>
