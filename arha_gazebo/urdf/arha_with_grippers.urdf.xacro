<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arha_complete">
  
  <!-- Include base ARHA robot -->
  <xacro:include filename="$(find arha_description)/urdf/ARHA.urdf"/>
  
  <!-- Include left gripper -->
  <xacro:include filename="$(find arha_gazebo)/urdf/grippers/left_gripper_mount.xacro"/>
  
  <!-- Include right gripper -->
  <xacro:include filename="$(find arha_gazebo)/urdf/grippers/right_gripper_mount.xacro"/>
  
  <!-- Include wrist cameras -->
  <xacro:include filename="$(find arha_gazebo)/urdf/sensors/camera_left_wrist.xacro"/>
  <xacro:include filename="$(find arha_gazebo)/urdf/sensors/camera_right_wrist.xacro"/>
  
  <!-- Include chest camera -->
  <xacro:include filename="$(find arha_gazebo)/urdf/sensors/camera_chest.xacro"/>
  
  <!-- Add world link for fixed base (temporary for testing) -->
  <link name="world"/>
  
  <!-- Fix base_link to world -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="world_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
  <!-- Gazebo - Make base_link heavier and more stable -->
  <gazebo reference="base_link">
    <gravity>true</gravity>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Simplified collision geometries for better performance -->
  <gazebo reference="chest_link">
    <collision name="chest_collision_simple">
      <geometry>
        <box>
          <size>0.25 0.20 0.15</size>
        </box>
      </geometry>
    </collision>
  </gazebo>

  <!-- Arm link simplified collisions - use cylinders for link segments -->
  <gazebo reference="ShoulderLU_link">
    <collision name="shoulder_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.12</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ShoulderLD_link">
    <collision name="shoulder_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.16</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowLU_link">
    <collision name="elbow_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.10</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowLD_link">
    <collision name="elbow_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.20</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristLU_link">
    <collision name="wrist_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.06</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristLD_link">
    <collision name="wrist_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.08</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <!-- Right arm simplified collisions -->
  <gazebo reference="ShoulderRU_link">
    <collision name="shoulder_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.12</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ShoulderRD_link">
    <collision name="shoulder_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.16</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowRU_link">
    <collision name="elbow_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.10</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowRD_link">
    <collision name="elbow_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.20</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristRU_link">
    <collision name="wrist_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.06</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristRD_link">
    <collision name="wrist_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.08</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>
  
  <!-- ros2_control hardware interface for Gazebo Classic -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <!-- Left Arm Joints -->
    <joint name="ShoulderLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ShoulderLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <!-- Right Arm Joints -->
    <joint name="ShoulderRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ShoulderRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Left Gripper Joints -->
    <joint name="left_cam_joint">
      <command_interface name="position">
        <param name="min">-0.57</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right Gripper Joints -->
    <joint name="right_cam_joint">
      <command_interface name="position">
        <param name="min">-0.57</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  
  <!-- Gazebo Classic ros2_control plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <ros>
        <namespace>/</namespace>
        <argument>--ros-args</argument>
      </ros>
      <parameters>$(find arha_gazebo)/config/gazebo_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  
</robot>