<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arha_complete">
  
  <!-- Include base ARHA robot -->
  <xacro:include filename="$(find arha_description)/urdf/ARHA_base.xacro"/>
  <xacro:arha_base />

  <!-- MoveIt2-aligned pincopen grippers + wrist cameras -->
  <xacro:include filename="$(find arha_gazebo)/urdf/grippers/pincopen.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>
  
  <!-- Add the Head assembly -->
  <xacro:include filename="$(find head)/urdf/head.xacro"/>
  <!-- Raised head slightly higher (z=0.25) to ensure it clears the chest bounding box visibly -->
  <xacro:arha_head parent="chest_link">
    <origin xyz="-0.1 0 0.08" rpy="0 0 0" />
  </xacro:arha_head>

  <!-- Mount D435 Camera to the Head -->
  <xacro:sensor_d435 parent="head_part_1_4" name="head_camera" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
    <origin xyz="-0.18 -0.12 -0.037" rpy="1.5708 0 -1.5708"/>
  </xacro:sensor_d435>

  <xacro:pincopen_gripper prefix="left" parent="WristLD_link">
    <origin xyz="0 0 0.13" rpy="1.5708 -1.5708 3.14159" />
  </xacro:pincopen_gripper>

  <xacro:sensor_d435 parent="left_Camera_mount_V1" name="left_camera" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
    <origin xyz="-0.01 -0.008 0.011" rpy="0 0 1.5708"/>
  </xacro:sensor_d435>

  <xacro:pincopen_gripper prefix="right" parent="WristRD_link">
    <origin xyz="0 0 0.13" rpy="1.5708 -1.5708 0.0" />
  </xacro:pincopen_gripper>

  <xacro:sensor_d435 parent="right_Camera_mount_V1" name="right_camera" use_nominal_extrinsics="false" add_plug="false" use_mesh="true">
    <origin xyz="-0.01 -0.008 0.011" rpy="0 0 1.5708"/>
  </xacro:sensor_d435>

  <!-- Fixed base in Gazebo -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.15 0 0.00" rpy="0 0 0"/>
  </joint>
  
  <!-- Gazebo - Make base_link heavier and more stable -->
  <gazebo reference="base_link">
    <gravity>true</gravity>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Simplified collision geometries for better performance -->
  <gazebo reference="chest_link">
    <collision name="chest_collision_simple">
      <geometry>
        <box>
          <size>0.25 0.20 0.15</size>
        </box>
      </geometry>
    </collision>
  </gazebo>

  <!-- Arm link simplified collisions - use cylinders for link segments -->
  <gazebo reference="ShoulderLU_link">
    <collision name="shoulder_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.12</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ShoulderLD_link">
    <collision name="shoulder_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.16</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowLU_link">
    <collision name="elbow_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.10</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowLD_link">
    <collision name="elbow_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.20</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristLU_link">
    <collision name="wrist_lu_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.06</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristLD_link">
    <collision name="wrist_ld_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.08</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <!-- Right arm simplified collisions -->
  <gazebo reference="ShoulderRU_link">
    <collision name="shoulder_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.12</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ShoulderRD_link">
    <collision name="shoulder_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.04</radius>
          <length>0.16</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowRU_link">
    <collision name="elbow_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.10</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="ElbowRD_link">
    <collision name="elbow_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.03</radius>
          <length>0.20</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristRU_link">
    <collision name="wrist_ru_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.06</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>

  <gazebo reference="WristRD_link">
    <collision name="wrist_rd_collision_simple">
      <geometry>
        <cylinder>
          <radius>0.02</radius>
          <length>0.08</length>
        </cylinder>
      </geometry>
    </collision>
  </gazebo>
  
  <!-- ros2_control hardware interface for Gazebo Classic -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <!-- Left Arm Joints -->
    <joint name="ShoulderLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ShoulderLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristLU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristLD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <!-- Right Arm Joints -->
    <joint name="ShoulderRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ShoulderRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="ElbowRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristRU_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="WristRD_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper actuation joints -->
    <joint name="left_cam_joint">
      <command_interface name="position">
        <param name="min">-0.57</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.30</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_cam_joint">
      <command_interface name="position">
        <param name="min">-0.57</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.30</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Left Gripper Mimic Joints -->
    <joint name="left_Revolute_2_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_Revolute_3_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_Revolute_4_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_Revolute_5_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_Revolute_6_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_Revolute_7_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Right Gripper Mimic Joints -->
    <joint name="right_Revolute_2_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_Revolute_3_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_Revolute_4_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_Revolute_5_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_Revolute_6_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_Revolute_7_0">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>
  
  <!-- Gazebo Classic ros2_control plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <ros>
        <namespace>/</namespace>
      </ros>
      <robot_param_node>/robot_state_publisher/robot_state_publisher</robot_param_node>
      <parameters>$(find arha_gazebo)/config/gazebo_controllers.yaml</parameters>
    </plugin>
  </gazebo>
  
</robot>