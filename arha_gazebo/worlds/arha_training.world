<?xml version="1.0"?>
<sdf version="1.6">
  <world name="arha_training">

    <!-- Physics -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table in front of robot -->
    <model name="table">
      <static>true</static>
      <pose>0 -0.35 0 0 0 1.5708</pose>
      <link name="table_link">
        <!-- Table top -->
        <collision name="table_top_collision">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.6 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_top_visual">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.6 0.02</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>

        <!-- Table legs -->
        <collision name="leg1_collision">
          <pose>0.18 0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>0.18 0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <collision name="leg2_collision">
          <pose>0.18 -0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>0.18 -0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <collision name="leg3_collision">
          <pose>-0.18 0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>-0.18 0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

        <collision name="leg4_collision">
          <pose>-0.18 -0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>-0.18 -0.28 0.2 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Receiving bowl for placing cubes -->
    <!-- Object 1 with ArUco marker ID 0 -->
    <model name="box_aruco_0">
      <pose>0.15 -0.35 0.44 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <iyy>0.00008</iyy>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <!-- ArUco marker on top face -->
        <visual name="aruco_marker_top">
          <pose>0 0 0.0201 0 0 0</pose>
          <geometry>
            <box>
              <size>0.035 0.035 0.001</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://aruco_marker_0/materials/scripts/aruco.material</uri>
              <uri>model://aruco_marker_0/materials/textures</uri>
              <name>ArucoMarker0</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object 2 with ArUco marker ID 1 -->
    <model name="box_aruco_1">
      <pose>0.05 -0.35 0.44 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <iyy>0.00008</iyy>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
        <!-- ArUco marker on top face -->
        <visual name="aruco_marker_top">
          <pose>0 0 0.0201 0 0 0</pose>
          <geometry>
            <box>
              <size>0.035 0.035 0.001</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://aruco_marker_1/materials/scripts/aruco.material</uri>
              <uri>model://aruco_marker_1/materials/textures</uri>
              <name>ArucoMarker1</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Object 3 with ArUco marker ID 2 -->
    <!-- Large drop-off marker on the left -->
    <model name="drop_zone_marker">
      <static>true</static>
      <pose>-0.18 -0.35 0.405 0 0 0</pose>
      <link name="marker_link">
        <collision name="marker_collision">
          <geometry>
            <box>
              <size>0.16 0.16 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>0.16 0.16 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>model://aruco_marker_2/materials/scripts/aruco.material</uri>
              <uri>model://aruco_marker_2/materials/textures</uri>
              <name>ArucoMarker2</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
